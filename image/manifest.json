{
  "manifest_version": 2,
  "name": "Image Format & Resolution HUD",
  "version": "1.0",
  "description": "Displays an unobtrusive technical diagnostics HUD (format, bit depth, resolution, scaling, file size, and BPP) for qualifying images.",
  "permissions": [
    "menus",
    "storage",
    "webRequest",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "shared/settings.js",
      "image-probe.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/settings.js",
        "shared/appearance.js",
        "shared/hud.js",
        "image-probe.js",
        "auto-badges.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "shared/options.html",
    "open_in_tab": false,
    "browser_style": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "image-format-hud@birdie-github",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
